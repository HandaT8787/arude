<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h1 class="fs-3 mb-1 arude-logo-title">ここにアルデー</h1>
      <p class="text-muted fs-6 mb-4 arude-description">地図から探してみるで！</p>

      <div id="map-search"
        data-posts="<%= @posts.to_json(only: [:id, :title, :latitude, :longitude]) %>"
        data-center-lat="<%= @center_lat %>" 
        data-center-lng="<%= @center_lng %>"
        class="map-search rounded-3 mb-3"></div>
          
      <%= form_with url: map_searches_path, method: :get do %>
        <div class="d-flex justify-content-center align-items-center gap-3">
          <%= label_tag :radius, "検索半径(km)", class: "form-label font-medium mb-0" %>
          <%= select_tag :radius, options_for_select([3, 5, 10, 20, 30], @radius), class: "form-select arude-input w-25" %>
          <%= hidden_field_tag :lat, @center_lat, id: "map-search-lat" %>
          <%= hidden_field_tag :lng, @center_lng, id: "map-search-lng" %>
          <button type="button" id="search-here-button" class="btn arude-btn-secondary font-medium">この位置で探す</button>
        </div>
      <% end %>
    </div>
  </div>
</div>