<div class="container py-4">
  <h1 class="fs-3 mb-4 arude-logo-title">検索結果のアルデー</h1>
  <%= form_with url: searches_path, method: :get, class: "d-flex gap-3 mb-3 justify-content-end" do %>
    <div>
      <%= text_field_tag :keyword, params[:keyword], placeholder: "検索キーワード", class: "form-control arude-input" %>
    </div>
    <div>
      <%= select_tag :category, options_for_select(["公園", "景色", "自然", "写真スポット", "ベンチ", "神社・歴史", "散歩スポット"], params[:category]), include_blank: "検索カテゴリ", class: "form-select arude-input" %>
    </div>
    <div>
      <%= text_field_tag :tag_name, params[:tag_name], placeholder: "検索タグ", class: "form-control arude-input" %>
    </div>
    <div>
      <%= submit_tag "検索", class: "btn arude-btn-secondary" %>
    </div>
  <% end %>
  <div class="row mb-3">
    <% @results.each do |result| %>
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm mb-2">
          <% if thumb = result.thumbnail(400, 400) %>
            <%= link_to post_path(result) do %>
              <%= image_tag thumb, class: "card-img-top post-thumb" %>
            <% end %>
          <% else %>
            <div class="bg-light d-flex align-items-center justify-content-center post-thumb-placeholder card-img-top">
              <i class="fa-solid fa-image text-secondary fs-2"></i>
            </div>
          <% end %>
          <div class="card-body">
            <h2 class="fs-6 mb-1"><%= link_to result.title, post_path(result), class: "text-decoration-none text-dark" %></h2>
            <p class="text-muted small mb-2"><%= result.category %></p>
            <% if badge = result.local_badge %>
              <span class="badge rounded-pill badge-local fw-normal"><%= badge %></span>
            <% end %>
            <div class="mt-2">
              <% result.tags.where(tag_type: "feature").each do |tag| %>
                <span class="badge rounded-pill badge-feature"><%= tag.name %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 d-flex justify-content-center">
    <%= paginate @results %>
  </div>
</div>