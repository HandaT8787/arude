<div class="container py-4">
  <h1 class="fs-3 mb-4 arude-logo-title">検索結果のアルデー</h1>

  <div class="mb-3">
    <%= render "posts/search_form" %>
  </div>

  <div class="row mb-3">
    <%= render partial: "posts/post_card", collection: @results, as: :post %>
  </div>

  <div class="mt-4 d-flex justify-content-center">
    <%= paginate @results %>
  </div>
</div>