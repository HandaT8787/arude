<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "アルデー" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>

    <%# 1. Bootstrap（土台） %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>

    <%# 2. Swiper（機能ライブラリ） %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <%# 3. Font Awesome %>
    <script src="https://kit.fontawesome.com/53b57606ef.js" crossorigin="anonymous"></script>

    <%# 4. Google Fonts %>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Yusei+Magic&family=Kosugi+Maru&family=M+PLUS+Rounded+1c:wght@500;700&display=swap" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    
    <%= stylesheet_link_tag "arude" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="arude-bg d-flex flex-column min-vh-100">
    <%= render 'shared/header' %>
    <main class="flex-grow-1 d-flex flex-column">
      <%= yield %>
    </main>
    <footer class="arude-footer text-center py-3">
      <p class="mb-0 small">&copy; 2026 アルデー</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV["GOOGLE_MAPS_API_KEY"] %>"></script>
  </body>
</html>
