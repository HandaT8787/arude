<div class="container py-4">
  <h1 class="fs-3 mb-4 arude-logo-title">グループ一覧</h1>
  <div class="text-end">
    <%= link_to "グループ作成", new_group_path, class: "btn arude-btn-primary" %>
  </div>
  <div class="row mb-3">
    <% @groups.each do |group| %>
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm mb-2">
          <div class="card-body">
            <h2 class="fs-6 mb-1"><%= link_to group.name, group_path(group), class: "text-decoration-none text-dark" %></h2>
            <p class="text-muted small mb-2"><%= group.description %></p>
            <div class="mt-2">
              <span>参加人数: <%= group.group_memberships.count %></span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 d-flex justify-content-center">
    <%= paginate @groups %>
  </div>
</div>