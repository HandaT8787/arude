<div class="container py-4">

  <%= render "shared/flash" %>
  
  <h1 class="fs-3 mb-4">グループ一覧</h1>
  <%= link_to "グループ作成", new_group_path, class: "btn arude-btn-primary btn-sm mb-3" %>

  <div class="row mb-3">
    <% @groups.each do |group| %>
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm mb-2">
          <div class="card-body">
            <%= link_to group_path(group), class: "text-decoration-none text-dark" do %>
              <h2 class="fs-6 mb-1"><%= group.name %></h2>
              <p class="text-muted small mb-2"><%= group.description %></p>
              <div class="mt-2">
                <span>参加人数: <%= group.group_memberships.count %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 d-flex justify-content-center">
    <%= paginate @groups %>
  </div>
</div>