<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <h2 class="mb-4">ログイン</h2>
      <% if flash[:alert] %>
        <div class="alert alert-danger>
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert alert-success>
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with url: session_path do |form| %>
        <div class="input-group mb-3">
          <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
          <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", placeholder: "ユーザーID", class: "form-control", value: params[:username] %>
        </div>

        <div class="input-group mb-3">
          <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "パスワード", class: "form-control", maxlength: 72 %>
        </div>

        <%= form.submit "ログイン" %>
      <% end %>
      <br>

      <%= link_to "Forgot password?", new_password_path %>
    </div>
  </div>
</div>