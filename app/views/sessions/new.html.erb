<div class="d-flex align-items-center justify-content-center arude-bg arude-min-vh-90">
  <div class="container">
    <div class="row justify-content-center w-100">
      <div class="col-md-5">

        <div class="text-center mb-3">
          <div class="arude-logo-circle rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <h1 class="arude-logo-title fs-1">アルデー</h1>
        </div>

        <div class="arude-catch rounded-3 p-2 px-3 mb-4 text-center">
          <p class="mb-0 fs-5">ちょっとええとこ<br>あったで、行ってみ！</p>
        </div>

        <% if flash[:alert] %>
          <div class="alert arude-alert-danger rounded-3">
            <%= flash[:alert] %>
          </div>
        <% end %>
        <% if flash[:notice] %>
          <div class="alert arude-alert-success rounded-3">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <%= form_with url: session_path do |form| %>
          <div class="input-group mb-3">
            <span class="input-group-text bg-white"><i class="fa-solid fa-user"></i></span>
            <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", placeholder: "ユーザーID", class: "form-control arude-input", value: params[:username] %>
          </div>

          <div class="input-group mb-3">
            <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
            <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "パスワード", class: "form-control arude-input", maxlength: 72 %>
          </div>

          <%= form.submit "ログイン", class: "btn w-100 rounded-3 py-2 arude-btn-primary" %>
        <% end %>
        <br>
        <div class="text-center mt-3 small">
          <%= link_to "パスワードをお忘れですか？", new_password_path, class: "arude-link-accent fw-medium" %>
        </div>
      </div>
    </div>
  </div>
</div>