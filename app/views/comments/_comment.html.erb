<div id="comment_<%= comment.id %>" class="d-flex justify-content-between align-items-center p-2 mb-2 rounded-3 comment-bubble">
  <div>
    <p class="mb-1"><%= comment.body %></p>
    <div class="d-flex justify-content-between align-items-center gap-2">
      <div>
        <span class="text-muted small"><%= comment.created_at.strftime("%Y/%m/%d %H:%M") %></span>
      </div>
      <% if name = comment.author_name %>
        <div>
          <%= name %>
        </div>
      <% end %>
    </div>
  </div>
  <% if current_user.is_admin? || current_user == comment.user %>
    <div>
      <%= button_to "削除", post_comment_path(post, comment), method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: "削除しますか？" } %>
    </div>
  <% end %>
</div>