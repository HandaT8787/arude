<div class="container py-4">

  <%= render "shared/flash" %>
  
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-3 d-inline-block fs-4">会員一覧</h2>

  <table class="table border border-start-0 border-end-0 mx-4">
    <thead>
      <tr>
        <th class="bg-light">会員ID</th>
        <th class="bg-light">氏名</th>
        <th class="bg-light">ユーザー名</th>
        <th class="bg-light">メールアドレス</th>
        <th class="bg-light">ステータス</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="align-middle"><%= user.id %></td>
          <td class="align-middle"><%= link_to "#{user.name}", admin_user_path(user), class: "text-black" %></td>
          <td class="align-middle"><%= user.username %></td>
          <td class="align-middle"><%= user.email_address %></td>
          <td class="align-middle">
            <% if user.active? %>
              <span class="text-success fw-bold">有効</span>
            <% else %>
              <span class="text-muted">退会</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @users %>
  </div>
</div>