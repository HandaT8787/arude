<div class="container py-4">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-3 d-inline-block fs-4"> <%= @user.username %>さんの詳細 </h2>
  <table class="table border border-start-0 border-end-0 ms-5 w-75">
    <tbody>
      <tr>
        <th class="bg-light w-25">会員ID</th>
        <td><%= @user.id %></td>
      </tr>
      <tr>
        <th class="bg-light">氏名</th>
        <td><%= @user.name %></td>
      </tr>
      <tr>
        <th class="bg-light">ユーザー名</th>
        <td><%= @user.username %></td>
      </tr>
      <tr>
        <th class="bg-light">メールアドレス</th>
        <td><%= @user.email_address %></td>
      </tr>
      <tr>
        <th class="bg-light">ステータス</th>
        <td>
          <% if @user.active? %>
            <span class="text-success fw-bold">有効</span>
          <% else %>
            <span class="text-muted">退会</span>
          <% end %>
        </td>
      </tr>
      <tr>
        <th class="bg-light">現在の拠点住所</th>
        <td>
          <% if residence = @user.current_residence %>
            <%= residence.prefecture %><%= residence.city %>
          <% else %>
            <span class="text-muted">未登録</span>
          <% end %>
        </td>
      </tr>
      <tr>
        <th class="bg-light">所属グループ</th>
        <td>
          <% if @user.groups.any? %>
            <% @user.groups.each do |group| %>
              <%= link_to group.name, group_path(group), class: "badge rounded-pill badge-feature text-decoration-none me-1" %>
            <% end %>
          <% else %>
            <span class="text-muted">なし</span>
          <% end %>
        </td>
      </tr>
      <tr>
        <th class="bg-light">投稿数</th>
        <td><%= @user.posts.count %></td>
      </tr>
    </tbody>
  </table>
  <div class="mt-3 ms-5">
    <%= link_to "編集する", edit_admin_user_path(@user), class: "btn arude-btn-primary btn-sm" %>
    <%= link_to "一覧に戻る", admin_users_path, class: "btn arude-btn-tertiary btn-sm" %>
  </div> 
</div>