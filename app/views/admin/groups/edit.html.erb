<div class="container">
  <h2 class="bg-body-secondary rounded-0 px-3 py-1 mt-3 mb-5 d-inline-block fs-4">
    <%= @group.name %>のグループ情報編集
  </h2>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <%= form_with model: @group, url: admin_group_path(@group), method: :patch do |f| %>
        <% if @group.errors.any? %>
          <div class="text-danger mb-2">
            <% @group.errors.full_messages.each do |msg| %>
              <ul>
                <li class="mb-2"><%= msg %></li>
              </ul>
            <% end %>
          </div>
        <% end %>

        <div class="row mb-3 align-items-center">
          <%= f.label :id, "グループID", class: "col-3 col-form-label" %>
          <div class="col-3"><%= @group.id %></div> 
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :name, "グループ名", class: "col-3 col-form-label" %>
          <div class="col-6">
            <%= f.text_field :name, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :description, "説明文", class: "col-3 col-form-label" %>
          <div class="col-6">
            <%= f.text_area :description, rows: 4, class: "form-control" %>
          </div>
        </div>

        <div class="row justify-content-center mb-4">
          <%= f.submit "変更を保存", class: "btn btn-success px-2 col-6 col-md-3 col-lg-3" %>
        </div>
      <% end %>
    </div>
  </div>
</div>