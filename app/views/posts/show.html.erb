<div class="container py-4">
  <%# 退会した本人にはグループ名、ボタン、コメント欄を隠す（3か所で隠す） %>
  <% group_info_visible = @post.group_info_visible_to?(current_user) %>
  <div class="row justify-content-center">
    <div class="col-md-7">

      <%= render "shared/flash" %>

      <% if @post.photos.attached? %>
        <div class="swiper-area">
          <div class="swiper post-swiper mb-3">
            <div class="swiper-wrapper">
              <% @post.photos.each do |photo| %>
                <div class="swiper-slide">
                  <%= image_tag photo.variant(resize_to_limit: [800, 800]),
                        class: "d-block w-100 post-carousel-img js-photo-modal-trigger",
                        data: { bs_toggle: "modal", bs_target: "#photoModal" } %>
                </div>
              <% end %>
            </div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-pagination"></div>
          </div>
        </div>
      <% end %>

      <%# 拡大表示用モーダル %>
      <div class="modal fade" id="photoModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content post-photo-modal-content">
            <button type="button" class="btn-close btn-close-white ms-auto me-2 mt-2" data-bs-dismiss="modal"></button>
            <img id="photoModalImage" src="" class="post-photo-modal-image">
          </div>
        </div>
      </div>

      <%# タイトル、投稿日時 %>
      <h1 class="fs-3 mb-1"><%= @post.title %></h1>
      <p class="text-muted small"><i class="fa-regular fa-clock me-1"></i><%= @post.created_at.strftime("%Y/%m/%d %H:%M") %></p>

      <%# 投稿カテゴリー、混雑情報・料金は記入があれば表示 %>
      <p class="text-muted small mb-2">
        <%= @post.category %>
        <% if @post.congestion.present? %>・<%= @post.congestion %><% end %>
        <% if @post.price.present? %>・<%= number_to_currency(@post.price, precision: 0) %><% end %>
      </p>

      <%# 近所歴バッジ %>
      <% if badge = @post.local_badge %>
        <div class="mb-2">
          <span class="badge rounded-pill badge-local"><%= badge %></span>
        </div>
      <% end %>

      <% if name = @post.author_name %>
        <div class="d-flex align-items-center gap-3 mb-2">
          <div>
            <%= link_to name, user_path(@post.user), class: "arude-link-accent" %>
          </div>

          <%# 参加中のグループ投稿であればグループ名表示 %>
          <% if group_info_visible %>
            <div>
              <%= link_to @post.group.name, group_path(@post.group), class: "badge rounded-pill badge-group text-decoration-none" %>
            </div>
          <% end %>

        </div>
      <% end %>

      <div class="mb-3">
        <% @post.tags.where(tag_type: "feature").each do |tag| %>
          <%= link_to tag.name, searches_path(tag_name: tag.name), class: "badge rounded-pill badge-feature text-decoration-none" %>
        <% end %>
        <% @post.tags.where(tag_type: "time").each do |tag| %>
          <%= link_to tag.name, searches_path(tag_name: tag.name), class: "badge rounded-pill badge-time text-decoration-none" %>
        <% end %>
      </div>

      <%# 投稿者の入力のまま表示するためにsimple_format使用 %>
      <p><%= simple_format(@post.description) %></p>
      <% if @post.caution.present? %>
        <div class="alert arude-alert-danger rounded-3 small"><%= @post.caution %></div>
      <% end %>

      <%# 投稿者であれば表示 %>
      <% if current_user == @post.user %>
        <div class="d-flex gap-2 mb-3">

          <%# グループから退会するとグループ投稿を編集できなくするための条件 %>
          <% if @post.editable_by?(current_user) %>
            <div>
              <%= link_to "編集する", edit_post_path(@post), class: "btn btn-secondary btn-sm", data: { turbo: false } %>
            </div>
          <% end %>

          <div>
            <%= button_to "削除する", post_path(@post), method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: "削除しますか？" } %>
          </div>
        </div>
      <% end %>

      <div id="post-map" data-lat="<%= @post.latitude %>" data-lng="<%= @post.longitude %>" class="post-map rounded-3 mb-3"></div>

      <%# グループ情報を見られる人にだけ、行ってみたい、行ってみた機能を表示 %>
      <div class="mb-3">
        <% if group_info_visible %>
          <div class="d-flex gap-2 mb-3 justify-content-around align-items-center">

            <%= render "bookmarks/button", post: @post %>

            <%= link_to new_post_visit_path(@post), class: "btn arude-btn-primary btn-sm btn-compact" do %>
              <i class="fa-solid fa-person-running"></i> 行ってみた
            <% end %>
            <%= link_to post_visits_path(@post), class: "btn arude-btn-tertiary btn-sm btn-mini" do %>
              <i class="fa-solid fa-address-book"></i> 行ってみた一覧<br>(<%= @post.visits.count %>件)
            <% end %>
          </div>
        <% end %>
      </div>

      <% if group_info_visible %>
        <hr>

        <%# コメント機能（他メンバーのコメントが見えないように退会した本人には隠す） %>
        <h2 class="fs-5 mb-3">みんなのひとこと</h2>
        <%= render "comments/form", post: @post %>

        <div id="comments_list">
          <%= render partial: "comments/comment", collection: @post.comments.order(created_at: :desc), as: :comment, locals: { post: @post } %>
        </div>

      <% end %>

    </div>
  </div>
</div>