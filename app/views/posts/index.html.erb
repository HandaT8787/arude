<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="fs-3 arude-logo-title">みんなのアルデー</h1>
    <%= link_to map_searches_path, class: "btn arude-btn-secondary btn-sm", data: { turbo: false } do %>
      <i class="fa-solid fa-map-location-dot"></i> 地図で探す
    <% end %>
  </div>

  <p class="text-muted fs-6 mb-4 arude-description">みんなええとこ知ってんなぁ！</p>

  <div class="mb-3">
    <%= render "search_form" %>
  </div>

  <div class="mb-3">
    <% if current_user %>
      <%= link_to "アルデー作成", new_post_path, class: "btn arude-btn-primary", data: { turbo: false } %>
    <% end %>
  </div>

  <div class="row mb-3">
    <%= render partial: "post_card", collection: @posts, as: :post %>
  </div>

  <div class="mt-4 d-flex justify-content-center">
    <%= paginate @posts %>
  </div>
</div>